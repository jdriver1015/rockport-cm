# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API, and Project Settings → Database)

# Postgres connection string — use the "Transaction" pooler URL from Supabase
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase client (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only key for storage uploads and admin operations — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Used to build the email-confirmation / magic-link redirect URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bid invitations (Resend). Without RESEND_API_KEY the app still mints links,
# records invitations and shows the draft — it just reports delivery as
# unconfigured. Sending is also refused unless NEXT_PUBLIC_SITE_URL above is a
# public host, so a local run cannot mail a vendor a localhost link.
RESEND_API_KEY=<resend-api-key>

# From address on invitations — its domain must be verified in Resend
BID_FROM_ADDRESS=bids@multifamily-construction.io

# Guards /api/cron/slip-targets, the nightly pass that pushes missed phase
# targets forward. Vercel sends this as a bearer token on scheduled runs.
# Without it the endpoint refuses; unauthenticated it would let anyone
# reschedule the portfolio.
CRON_SECRET=<random-string>
